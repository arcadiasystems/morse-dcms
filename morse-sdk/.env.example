# Copy to .env.local and fill in real values.
# .env.local is gitignored.

# suiprivkey1... bech32 secret key.
# Get it via: sui keytool export --key-identity <alias>
PRIVATE_KEY=

# Optional: override the RPC URL for the selected network.
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Optional: which network the smoke scripts target. Defaults to testnet.
# Only mainnet and testnet are valid; Walrus has no localnet deployment.
# MORSE_NETWORK=testnet

# Required alongside MORSE_NETWORK=mainnet. The smokes create and delete
# real content, so mainnet costs real SUI and WAL; this second variable
# makes that choice deliberate rather than an inherited-shell accident.
# MORSE_ALLOW_MAINNET=1
