{
	"name": "@arcadiasystems/morse-sdk",
	"version": "0.12.0",
	"description": "TypeScript SDK for Morse dCMS on the Sui blockchain.",
	"license": "MIT",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"keywords": [
		"sui",
		"walrus",
		"seal",
		"cms",
		"decentralized",
		"blockchain"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arcadiasystems/morse-dcms.git",
		"directory": "morse-sdk"
	},
	"homepage": "https://github.com/arcadiasystems/morse-dcms/tree/main/morse-sdk#readme",
	"bugs": {
		"url": "https://github.com/arcadiasystems/morse-dcms/issues"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"prebuild": "rm -rf dist",
		"prepublishOnly": "bun run lint && bun run typecheck && bun run docs-gate && bun test && bun run build",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"docs-gate": "bun scripts/docs-gate.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun test",
		"test:node-import": "node scripts/node-import-check.mjs",
		"test:coverage": "bun test --coverage"
	},
	"engines": {
		"bun": ">=1.2.0",
		"node": ">=18.0.0"
	},
	"peerDependencies": {
		"@mysten/seal": ">=1.5.4 <1.5.5",
		"@mysten/sui": ">=2.39.1 <2.40.0",
		"@mysten/walrus": ">=1.2.39 <1.2.40"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.7",
		"@mysten/bcs": "2.1.4",
		"@mysten/seal": "1.5.4",
		"@mysten/sui": "2.39.1",
		"@mysten/walrus": "1.2.39",
		"@types/bun": "latest",
		"typescript": "^5.6.0"
	}
}
